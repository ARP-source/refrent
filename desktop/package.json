{
  "name": "recallos",
  "productName": "Referent",
  "version": "1.0.0",
  "description": "Referent \u2014 a native browser with episodic memory and verified recall",
  "author": "RecallOS",
  "main": "main.js",
  "recallRoot": "C:\\da browser\\recall-os",
  "scripts": {
    "icon": "python make_icon.py",
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "dev.recallos.app",
    "productName": "Referent",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "splash.html",
      "icon.png",
      "package.json",
      "preload.js",
      "native-browser.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Referent"
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
